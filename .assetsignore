# Excludes backend-only / non-deployable material from the Cloudflare
# Workers static-assets bundle. Same syntax as .gitignore. Everything
# NOT listed here (index.html, css/, js/, _headers) gets uploaded and
# served publicly by `wrangler deploy` -- keep this list accurate if new
# top-level backend folders are ever added.

# Deployment config itself -- not meant to be served as a public file.
wrangler.toml
worker.js

# Database migrations and SQL -- server-side only, must never be public.
supabase/

# Internal build/deploy documentation -- not part of the app.
docs/

# Standard excludes.
.git/
.gitignore
node_modules/
*.md

# Behaviour checks (added 2026-08-15) -- test scripts, SQL fixtures and
# seed data. Not part of the app and must not be served publicly. Note
# *.md already covers checks/README.md, but the .sh/.sql/.mjs files here
# would otherwise be uploaded and served as static assets.
checks/

# Playwright dev dependency for checks/ (added 17 Aug 2026). node_modules is
# already excluded above; these two manifests would otherwise be served.
package.json
package-lock.json
